# ── Base de datos ─────────────────────────────────────────────
POSTGRES_USER=ventafacil
POSTGRES_PASSWORD=cambia_esto_en_produccion
POSTGRES_DB=ventafacil
# Usado por el API (dentro de Docker el host es "db", en local es "localhost")
DATABASE_URL=postgres://ventafacil:cambia_esto_en_produccion@localhost:5434/ventafacil

# ── API ───────────────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development
# Firma los tokens de sesion de los NEGOCIOS: el de acceso y el de refresco.
# (Hubo un JWT_REFRESH_SECRET que no firmaba nada; se quito. Lo que separa los dos
#  tokens es el claim `typ`, no la llave.)
#
# Este valor es para desarrollo y esta escrito en el repositorio, asi que como secreto
# vale cero: con el, cualquiera se firma un token de administrador de cualquier negocio.
# Por eso, en produccion, el API RECHAZA este literal, rechaza que falte y rechaza
# cualquiera de menos de 32 caracteres: se niega a arrancar. Es a proposito — un fallo
# ruidoso al desplegar se arregla en un minuto; el agujero callado no se descubre hasta
# que alguien lo usa.
#
# Genera el tuyo:  openssl rand -base64 48
JWT_ACCESS_SECRET=dev_access_secret_cambiame
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Firma los tokens del PANEL DE PLATAFORMA, que ve y administra TODOS los negocios.
# OBLIGATORIA en produccion y DISTINTA de JWT_ACCESS_SECRET: el API se niega a arrancar
# si falta o si se repite. Que sean dos llaves distintas es lo que impide que un token
# de un negocio sirva para el panel. Genera una propia: openssl rand -base64 48
JWT_PLATFORM_SECRET=
# Sesion del panel, mas corta que la de un negocio: es la cuenta con mas alcance.
JWT_PLATFORM_TTL=8h
# Pool chico: el VPS KVM1 tiene 1 vCPU
DB_POOL_MAX=8

# ── Seguridad ─────────────────────────────────────────────────
# OBLIGATORIA en produccion (NODE_ENV=production): el API no arranca sin ella.
# Origenes del frontend separados por coma. Vacio fuera de produccion = permite todos.
# CORS_ORIGINS=https://vertexweb.lat,https://www.vertexweb.lat
#
# Limite general por IP. Generoso: en una tienda todas las cajas salen por la misma IP.
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
# Limite del login, estricto: es el endpoint que se ataca por fuerza bruta.
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW=5 minutes

# ── Correo transaccional ──────────────────────────────────────
# Sin RESEND_API_KEY los correos NO se envian: se escriben en el log del API, con el
# enlace entero. Es lo que permite probar el registro y la recuperacion en local sin
# tener cuenta, y sin mandarle nada por error a nadie.
RESEND_API_KEY=
EMAIL_FROM=VentaFacil <no-responder@tudominio.com>
# URL de la app de un negocio. {slug} se sustituye por su subdominio. Es lo que se
# escribe en los enlaces del correo, asi que tiene que ser accesible desde fuera.
APP_URL_TEMPLATE=https://{slug}.tudominio.com
# Cuanto valen los enlaces que van por correo.
RESET_TOKEN_TTL_MIN=60
VERIFY_TOKEN_TTL_HOURS=72
# Registro y "olvide mi contrasena": tope estricto por IP. Lo que se frena no es la
# fuerza bruta sino el abuso del correo (inundar un buzon, llenar la base de basura).
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW=1 hour

# ── Operacion ─────────────────────────────────────────────────
# A donde avisar cuando el servidor lanza errores 500. Vacio = solo quedan en el log,
# y nadie mira un log a las 3 de la tarde de un martes. Usa el mismo Resend de arriba.
ALERT_EMAIL=
# Ventana de agrupacion: un correo por ventana con la cuenta, en vez de cien identicos.
ALERT_WINDOW_MIN=10

# ── Web ───────────────────────────────────────────────────────
# Vite lee ESTE archivo (el de la raíz), no uno dentro de apps/web: así las variables
# del front y las del API viven juntas. Lo hace posible `envDir` en vite.config.ts.
VITE_API_URL=http://localhost:3000
# Dominio base de la instalación. Es lo que permite deducir el negocio del subdominio:
# "mi-negocio.tudominio.com" -> mi-negocio. Sin esta variable el login NO sabe a qué
# negocio entra, y con más de uno en la misma base responde "Indica el negocio".
# En local vale "localhost", y se entra por http://mi-negocio.localhost:5173.
# El subdominio "admin" está reservado: es el panel de plataforma.
VITE_APP_DOMAIN=localhost
# Slug del negocio (solo si varios negocios comparten la misma BD). Si se deja
# vacío y hay un único negocio, el login lo resuelve automáticamente.
# VITE_BUSINESS_SLUG=llantas-el-rapidos
