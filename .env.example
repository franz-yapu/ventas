# ── Base de datos ─────────────────────────────────────────────
POSTGRES_USER=ventafacil
POSTGRES_PASSWORD=cambia_esto_en_produccion
POSTGRES_DB=ventafacil
# Usado por el API (dentro de Docker el host es "db", en local es "localhost")
DATABASE_URL=postgres://ventafacil:cambia_esto_en_produccion@localhost:5434/ventafacil

# ── API ───────────────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development
# Genera claves largas y aleatorias en produccion (openssl rand -hex 32)
JWT_ACCESS_SECRET=dev_access_secret_cambiame
JWT_REFRESH_SECRET=dev_refresh_secret_cambiame
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Pool chico: el VPS KVM1 tiene 1 vCPU
DB_POOL_MAX=8

# ── Web ───────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
