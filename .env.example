# ── Base de datos ─────────────────────────────────────────────
POSTGRES_USER=ventafacil
POSTGRES_PASSWORD=cambia_esto_en_produccion
POSTGRES_DB=ventafacil
# Usado por el API (dentro de Docker el host es "db", en local es "localhost")
DATABASE_URL=postgres://ventafacil:cambia_esto_en_produccion@localhost:5434/ventafacil

# ── API ───────────────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development
# Genera claves largas y aleatorias en produccion (openssl rand -hex 32)
JWT_ACCESS_SECRET=dev_access_secret_cambiame
JWT_REFRESH_SECRET=dev_refresh_secret_cambiame
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Pool chico: el VPS KVM1 tiene 1 vCPU
DB_POOL_MAX=8

# ── Seguridad ─────────────────────────────────────────────────
# OBLIGATORIA en produccion (NODE_ENV=production): el API no arranca sin ella.
# Origenes del frontend separados por coma. Vacio fuera de produccion = permite todos.
# CORS_ORIGINS=https://vertexweb.lat,https://www.vertexweb.lat
#
# Limite general por IP. Generoso: en una tienda todas las cajas salen por la misma IP.
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
# Limite del login, estricto: es el endpoint que se ataca por fuerza bruta.
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW=5 minutes

# ── Web ───────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
# Slug del negocio (solo si varios negocios comparten la misma BD). Si se deja
# vacío y hay un único negocio, el login lo resuelve automáticamente.
# VITE_BUSINESS_SLUG=llantas-el-rapidos
