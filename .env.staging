# Staging LOCAL (docker). Imita al VPS; NO son las credenciales de producción.
# Uso:
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up -d --build

# ── Base de datos (dueño de las tablas: migra, siembra, administra RLS) ──
POSTGRES_USER=ventafacil
POSTGRES_PASSWORD=staging_owner_pw
POSTGRES_DB=ventafacil

# ── Rol de aplicación (SIN privilegios: con este corre el API) ──
# Es la pieza clave de RLS: Postgres ignora las políticas para superusuarios y para el
# dueño de las tablas, así que el API NO puede conectarse con ellos.
APP_DB_ROLE=ventafacil_app
APP_DB_PASSWORD=staging_app_pw

# 1 = crear el rol y activar RLS al arrancar el contenedor.
ENABLE_RLS=1

# ── API ──
JWT_ACCESS_SECRET=staging_access_secret_no_usar_en_produccion
JWT_REFRESH_SECRET=staging_refresh_secret_no_usar_en_produccion
DB_POOL_MAX=8

# Obligatoria con NODE_ENV=production: el API no arranca sin ella.
CORS_ORIGINS=http://localhost:5173,http://localhost:3100
